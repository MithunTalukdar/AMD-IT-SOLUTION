# Backend Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas or Local)
# Example: mongodb+srv://username:password@cluster0.mongodb.net/amd_it_solution?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/amd_it_solution

# JWT Secret for authentication tokens
JWT_SECRET=super_secret_jwt_key_amd_it_solution_2026_secure

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGIN=http://localhost:5173,https://*.vercel.app

# Optional Razorpay Payment Gateway Keys (for online booking payments)
RAZORPAY_KEY_ID=rzp_test_samplekey1234
RAZORPAY_KEY_SECRET=sample_secret_key_5678
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_9012
